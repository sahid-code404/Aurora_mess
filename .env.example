# BoardOps core runtime configuration
# Copy to a local/deployment environment file and replace placeholders.
# Never commit real credentials.

# REQUIRED at runtime. BoardOps is PostgreSQL-only; file:/SQLite URLs are rejected
# by the deployment runtime guard.
DATABASE_URL=postgresql://boardops:change-me@127.0.0.1:5432/boardops?schema=public

# OPTIONAL for backup/restore tooling only. Leave unset for normal deployments.
# Use when the Prisma DATABASE_URL contains provider-specific query parameters
# that libpq/pg_dump/pg_restore cannot parse, or when recovery should use a
# dedicated administrative PostgreSQL connection.
# BOARDOPS_PG_URL=postgresql://boardops-admin:change-me@127.0.0.1:5432/boardops

# REQUIRED. Use a long random deployment secret. Do not reuse the CI/example value.
SESSION_SECRET=replace-with-a-long-random-production-secret

# Production should point this at a persistent, private filesystem volume.
# The directory must be writable by the BoardOps process and must not be web-served.
UPLOAD_STORAGE_DIR=/var/lib/boardops/uploads

# PREVIEW-ONLY compatibility switch for cross-site sandbox iframes that block
# third-party cookies entirely. Leave unset or 0 in normal/production deployments.
# When enabled, the login response may expose the opaque session token to the
# browser, but the client keeps it in memory only and never persistent storage.
ENABLE_PREVIEW_BEARER_AUTH=0

# Observability controls. API request JSON logging defaults ON in production and
# OFF outside production. Set explicitly when a deployment needs another policy.
# Logs contain request IDs, route pathname, status/duration and opaque user IDs;
# they do not include bodies, query strings, cookies, tokens, emails or IPs.
API_REQUEST_LOGGING=1

# Raw Prisma query logging is OFF by default, including production. Enable only
# during controlled diagnostics because SQL/query parameters can contain data.
PRISMA_LOG_QUERIES=0

# Unexpected-error stacks are OFF by default. Enable only for controlled server
# diagnostics; the client never receives stack traces regardless of this value.
LOG_ERROR_STACKS=0
